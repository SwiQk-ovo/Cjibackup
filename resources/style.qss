/* C极备份 - 暗黑透蓝主题 */

* {
    font-family: "Microsoft YaHei UI", "微软雅黑", sans-serif;
    font-size: 15px;
    color: #FFFFFF;
}

QMainWindow, QWidget#centralWidget {
    background-color: #111112;
}

/* 侧边栏 */
QFrame#sidebar {
    background-color: transparent;
    border: none;
}

QLabel#logoLabel {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 10px 0;
}

QPushButton#navButton {
    text-align: left;
    padding-left: 30px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #9C9C9F;
    font-size: 15px;
}

QPushButton#navButton:hover {
    background-color: #1B1B1D;
    color: #FFFFFF;
}

QPushButton#navButton:checked {
    background: transparent;
    color: #FFFFFF;
}

QFrame#navSlider {
    background-color: #26282C;
    border-radius: 12px;
}

/* 内容区 */
QStackedWidget#contentArea {
    background-color: #111112;
}

QLabel#pageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
}

/* 分组框 */
QGroupBox {
    background-color: #1B1B1D;
    border-radius: 16px;
    border: 1px solid #2E2E31;
    margin-top: 15px;
    padding: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
    color: #FFFFFF;
}

/* 输入框 */
QLineEdit {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 8px 16px;
    color: #EDEDEE;
}

QLineEdit:focus {
    border: 1px solid #4C8DFF;
}

/* 按钮 */
QPushButton {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    padding: 8px 18px;
    color: #EDEDEE;
}

QPushButton:hover {
    background-color: #26282C;
    border-color: #3A3D43;
}

QPushButton:pressed {
    background-color: #1B1B1D;
}

QPushButton:pressed {
    background-color: #2E2E31;
}

QPushButton#primaryBtn {
    background-color: #F2F2F3;
    color: #131314;
    font-weight: 600;
    border: none;
    border-radius: 20px;
    padding: 10px 30px;
}

QPushButton#primaryBtn:hover {
    background-color: #FFFFFF;
}

QPushButton#primaryBtn:pressed {
    background-color: #D9DEE6;
}

QPushButton#primaryBtn:disabled {
    background-color: #232528;
    color: #6E747C;
}

/* 下拉框 */
QComboBox {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 7px 30px 7px 16px;
    color: #EDEDEE;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #3A4354;
}

QComboBox:focus {
    border: 1px solid #4C8DFF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/resources/combo_arrow.png);
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:hover {
    image: url(:/resources/combo_arrow.png);
}

QComboBox QAbstractItemView {
    background-color: #1B1B1D;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 4px;
    color: #E3E7EE;
    outline: none;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding-left: 8px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #262628;
}

/* 复选框 */
QCheckBox {
    spacing: 8px;
    color: #FFFFFF;
    background: transparent;   /* 不设的话 Qt 会用调色板底色刷一条横条 */
    border: none;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #2E2E31;
    background-color: #111112;
}

QCheckBox::indicator:checked {
    background-color: #4C8DFF;
    border-color: #4C8DFF;
    image: url(:/resources/check.png);
}

QCheckBox::indicator:hover {
    border-color: #4C8DFF;
}

QCheckBox::indicator:checked:hover {
    background-color: #2563EB;
}

/* 进度条 */
QProgressBar {
    background-color: #262628;
    border: none;
    border-radius: 10px;
    text-align: center;
    height: 26px;
    color: #FFFFFF;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #4C8DFF;
    border-radius: 8px;
}

/* 列表 */
QListWidget {
    background-color: #1B1B1D;
    border: 1px solid #2E2E31;
    border-radius: 12px;
    padding: 8px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #2E2E31;
    color: #FFFFFF;
}

QListWidget::item:selected {
    background-color: #4C8DFF;
    border-radius: 6px;
}

/* 滑块 */
QSlider::groove:horizontal {
    height: 6px;
    background: #2E2E31;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background: #4C8DFF;
    border-radius: 9px;
}

/* 流程图：分类项面板 */
QLabel#flowChip {
    background-color: #262628;
    border: 1px solid #2F3746;
    border-radius: 8px;
    color: #D7DCE6;
    font-size: 13px;
}

QLabel#flowChip:hover {
    background-color: #2C3547;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

/* 流程图：目录预览 / 状态提示 */
QLabel#flowPreview {
    color: #8EA2C0;
    font-size: 13px;
}

QLabel#flowStatus {
    color: #60A5FA;
    font-size: 13px;
    padding-right: 4px;
}

QPushButton#flowClearBtn {
    background-color: transparent;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 4px 12px;
    color: #9C9C9F;
    font-size: 13px;
}

QPushButton#flowClearBtn:hover {
    color: #FFFFFF;
    border-color: #4C8DFF;
}

/* 页面滚动区 */
QScrollArea#pageScroll {
    background: transparent;
    border: none;
}

QScrollArea#pageScroll > QWidget > QWidget {
    background: transparent;
}

QLabel#settingLabel {
    color: #EDEDEE;
    font-size: 15px;
}

QWidget#settingRow {
    background: transparent;   /* 设置页的行容器：不刷底色，透出玻璃卡片 */
}

QWidget#pageContent {
    background: transparent;
}

/* 次要说明文字 */
QLabel#hintLabel {
    color: #6E747C;
    font-size: 13px;
}

QLabel#noticeLabel {
    color: #8EA2C0;
    font-size: 13px;
}

/* 弹出菜单 */
QMenu {
    background-color: #1B1B1D;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 18px;
    border-radius: 6px;
    color: #E3E7EE;
}

QMenu::item:selected {
    background-color: #4C8DFF;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #6B7280;
}

QMenu::separator {
    height: 1px;
    background: #2E2E31;
    margin: 5px 10px;
}


/* 关于页 */
QLabel#aboutLogo {
    font-size: 36px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#versionLabel {
    color: #9C9C9F;
    font-size: 15px;
}

/* 滚动条 */
QScrollBar:vertical {
    background: #0C0C0D;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: #0C0C0D;
}

QScrollBar::handle:vertical {
    background: #2E2E31;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4C8DFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border-radius: 4px;
    margin: 0 8px;
}

QScrollBar::handle:horizontal {
    background: #2E2E31;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4C8DFF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* 设置页：感叹号帮助图标 */
QLabel#helpIcon {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    color: #9C9C9F;
    font-size: 13px;
    font-weight: bold;
}

QLabel#helpIcon:hover {
    background-color: #4C8DFF;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

/* 数值 / 时间 / 日期输入 */
QSpinBox, QTimeEdit, QDateEdit, QDoubleSpinBox {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 7px 14px;
    color: #EDEDEE;
    min-height: 18px;
}

QSpinBox:focus, QTimeEdit:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    border: 1px solid #4C8DFF;
}

QSpinBox:disabled, QTimeEdit:disabled, QDateEdit:disabled, QComboBox:disabled,
QLineEdit:disabled, QCheckBox:disabled, QPushButton:disabled {
    color: #5C6673;
    background-color: #14181F;
    border-color: #232932;
}

QSpinBox, QTimeEdit, QDateEdit, QDoubleSpinBox {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 7px 14px;
    color: #EDEDEE;
    min-height: 18px;
}

QSpinBox::up-button, QTimeEdit::up-button, QDateEdit::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    border-left: 1px solid #232a36;
    border-top-right-radius: 8px;
    background: transparent;
}

QSpinBox::down-button, QTimeEdit::down-button, QDateEdit::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    border-left: 1px solid #232a36;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QSpinBox::up-button:hover, QTimeEdit::up-button:hover, QDateEdit::up-button:hover {
    background-color: #262628;
}

QSpinBox::down-button:hover, QTimeEdit::down-button:hover, QDateEdit::down-button:hover {
    background-color: #262628;
}

QSpinBox::up-arrow, QTimeEdit::up-arrow, QDateEdit::up-arrow {
    image: url(:/resources/arrow_up.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QTimeEdit::down-arrow, QDateEdit::down-arrow {
    image: url(:/resources/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* 日历弹窗 */
QCalendarWidget {
    background-color: #1B1B1D;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #262628;
}

QCalendarWidget QAbstractItemView {
    background-color: #1B1B1D;
    color: #E3E7EE;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

/* 系统提示气泡 */
QToolTip {
    background-color: #0B0F16;
    color: #FFFFFF;
    border: 1px solid #2E2E31;
    padding: 6px 8px;
    border-radius: 6px;
}

/* 弹框 */
QMessageBox, QDialog, QInputDialog {
    background-color: #1B1B1D;
}

QMessageBox QLabel, QDialog QLabel, QInputDialog QLabel {
    color: #E3E7EE;
}

QMessageBox QPushButton, QDialog QPushButton, QInputDialog QPushButton {
    min-width: 84px;
}

/* 托盘菜单（QMenu 已在上面统一样式） */
QMenu::icon {
    margin-left: 6px;
}

/* ---------------- 自定义消息框 ---------------- */
QDialog#darkDialog {
    background-color: #1B1B1D;
}

/* ---------------- 更新日志 ---------------- */
QDialog#changelogDialog {
    background-color: #111112;
}

QLabel#changelogTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
}

QLabel#changelogVersion {
    color: #60A5FA;
    font-size: 15px;
    font-weight: bold;
}

QLabel#changelogDate {
    color: #6E7888;
    font-size: 13px;
    padding-left: 2px;
}

QLabel#changelogBody {
    color: #C9D1E0;
    font-size: 15px;
}

QLabel#changelogBullet {
    color: #9AA4B6;
    font-size: 15px;
}

QScrollArea#changelogScroll,
QScrollArea#changelogScroll > QWidget > QWidget,
QWidget#changelogContent,
QWidget#changelogSectionBody {
    background: transparent;
    border: none;
}

/* 低调的描边按钮（关于页 / 设置页的「更新日志」） */
QPushButton#ghostBtn {
    background-color: transparent;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 5px 14px;
    color: #9C9C9F;
    font-size: 13px;
}

QPushButton#ghostBtn:hover {
    color: #FFFFFF;
    border-color: #4C8DFF;
}

QPushButton#ghostBtn:pressed {
    background-color: #1B1B1D;
}

QLabel#dialogText {
    color: #E3E7EE;
    font-size: 15px;
    line-height: 20px;
}

QPushButton#dialogPrimary {
    background-color: #4C8DFF;
    border-radius: 8px;
    padding: 9px 24px;
    min-width: 88px;
    font-weight: bold;
}

QPushButton#dialogPrimary:hover {
    background-color: #2563EB;
}

QPushButton#dialogPrimary:pressed {
    background-color: #1D4ED8;
}

QPushButton#dialogSecondary {
    background-color: #2E2E31;
    border-radius: 8px;
    padding: 9px 24px;
    min-width: 88px;
}

QPushButton#dialogSecondary:hover {
    background-color: #353B48;
}

QPushButton#dialogLink {
    background: transparent;
    border: none;
    color: #60A5FA;
    padding: 9px 4px;
    text-align: left;
}

QPushButton#dialogLink:hover {
    color: #93C5FD;
    text-decoration: underline;
}

/* ---------------- 合并节点：分隔符选择 ---------------- */
QDialog#separatorDialog {
    background-color: #1B1B1D;
}

QLabel#sepTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
}

QLabel#sepHint {
    color: #9C9C9F;
    font-size: 13px;
}

QPushButton#sepChip {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 7px 16px;
    color: #EDEDEE;
    font-size: 15px;
}

QPushButton#sepChip:hover {
    border-color: #3A4354;
}

QPushButton#sepChip:checked {
    background-color: rgba(76, 141, 255, 0.18);
    border-color: #4C8DFF;
    color: #FFFFFF;
}

QLabel#sepPreview {
    background-color: #17181A;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 9px 12px;
    color: #9C9C9F;
    font-size: 13px;
}

/* ---------------- 文件选择框（非原生，跟主题一致） ---------------- */
QFileDialog {
    background-color: #111112;
}

QFileDialog QLabel {
    color: #C9D2E0;
    background: transparent;
}

QFileDialog QLineEdit, QFileDialog QComboBox {
    background-color: #262628;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 7px 30px 7px 16px;
    color: #EDEDEE;
    min-height: 18px;
}

QFileDialog QListView, QFileDialog QTreeView {
    background-color: #0C0C0D;
    border: 1px solid #2E2E31;
    border-radius: 10px;
    color: #E3E7EE;
    outline: none;
}

QFileDialog QListView::item, QFileDialog QTreeView::item {
    padding: 4px 6px;
    border-radius: 6px;
}

QFileDialog QListView::item:selected, QFileDialog QTreeView::item:selected {
    background-color: #4C8DFF;
    color: #FFFFFF;
}

QFileDialog QListView::item:hover, QFileDialog QTreeView::item:hover {
    background-color: #262628;
}

QFileDialog QHeaderView {
    background-color: #1B1B1D;
    border: none;
}

QFileDialog QHeaderView::section {
    background-color: #1B1B1D;
    color: #9C9C9F;
    border: none;
    border-bottom: 1px solid #2E2E31;
    padding: 6px 8px;
}

QFileDialog QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    color: #C9D2E0;
}

QFileDialog QToolButton:hover {
    background-color: #262628;
}

QFileDialog QSplitter::handle {
    background-color: #111112;
}

QFileDialog QComboBox QAbstractItemView {
    background-color: #1B1B1D;
    border: 1px solid #2E2E31;
    selection-background-color: #4C8DFF;
}
/* ---------------- 应用内浮层提示 ---------------- */
/* 背景/边框由 SquircleCard 自绘（连续曲率圆角） */
QFrame#toastCard {
    background: transparent;
    border: none;
}

QLabel#toastTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

QLabel#toastText {
    color: #A9B2C1;
    font-size: 13px;
    background: transparent;
}

QPushButton#toastAction {
    background: transparent;
    border: none;
    color: #60A5FA;
    font-size: 13px;
    padding: 2px 0;
    text-align: left;
}

QPushButton#toastAction:hover {
    color: #93C5FD;
    text-decoration: underline;
}
/* ---------------- 文件 / 文件夹选择器 ---------------- */
QDialog#filePicker {
    background-color: #111112;
}

QLabel#pickerPath {
    color: #C9D2E0;
    background-color: #0C0C0D;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QLabel#pickerFieldLabel {
    color: #8B94A5;
    font-size: 13px;
}

QLabel#pickerHint {
    color: #6B7385;
    font-size: 13px;
    padding: 8px 2px;
}

QPushButton#pickerIconButton {
    background-color: #1B1B1D;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    color: #C9D2E0;
    font-size: 15px;
    padding: 0;
}

QPushButton#pickerIconButton:hover {
    background-color: #262628;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

QListWidget#pickerPlaces {
    background-color: #0C0C0D;
    border: 1px solid #232A36;
    border-radius: 10px;
    padding: 6px;
    outline: none;
    color: #C9D2E0;
}

QListWidget#pickerPlaces::item {
    height: 30px;
    padding-left: 6px;
    border-radius: 7px;
}

QListWidget#pickerPlaces::item:hover {
    background-color: #1F2531;
}

QListWidget#pickerPlaces::item:selected {
    background-color: #23324b;
    color: #FFFFFF;
}

QTreeView#pickerView {
    background-color: #0C0C0D;
    border: 1px solid #232A36;
    border-radius: 10px;
    alternate-background-color: #161b25;
    color: #D5DAE4;
    outline: none;
    padding: 4px;
}

QTreeView#pickerView::item {
    height: 30px;
    border-radius: 6px;
}

QTreeView#pickerView::item:hover {
    background-color: #1F2531;
}

QTreeView#pickerView::item:selected {
    background-color: #23324b;
    color: #FFFFFF;
}
/* 文件选择器：表头 / 滚动条 / 列表项（覆盖全局样式） */
QTreeView#pickerView QHeaderView {
    background: transparent;
    border: none;
}

QTreeView#pickerView QHeaderView::section {
    background-color: #0C0C0D;
    color: #8B94A5;
    border: none;
    border-bottom: 1px solid #232A36;
    padding: 6px 8px;
    font-size: 13px;
}

QTreeView#pickerView QScrollBar:vertical,
QListWidget#pickerPlaces QScrollBar:vertical {
    background: #0C0C0D;
    width: 10px;
    margin: 2px 2px 2px 0;
}

QTreeView#pickerView QScrollBar::add-page:vertical,
QTreeView#pickerView QScrollBar::sub-page:vertical,
QListWidget#pickerPlaces QScrollBar::add-page:vertical,
QListWidget#pickerPlaces QScrollBar::sub-page:vertical {
    background: #0C0C0D;
}

QTreeView#pickerView QScrollBar::handle:vertical,
QListWidget#pickerPlaces QScrollBar::handle:vertical {
    background: #2E3646;
    border-radius: 4px;
    min-height: 28px;
}

QTreeView#pickerView QScrollBar::handle:vertical:hover,
QListWidget#pickerPlaces QScrollBar::handle:vertical:hover {
    background: #4C8DFF;
}

QTreeView#pickerView QScrollBar::add-line:vertical,
QTreeView#pickerView QScrollBar::sub-line:vertical,
QListWidget#pickerPlaces QScrollBar::add-line:vertical,
QListWidget#pickerPlaces QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QTreeView#pickerView QScrollBar::add-page:vertical,
QTreeView#pickerView QScrollBar::sub-page:vertical,
QListWidget#pickerPlaces QScrollBar::add-page:vertical,
QListWidget#pickerPlaces QScrollBar::sub-page:vertical {
    background: transparent;
}

QTreeView#pickerView QAbstractScrollArea::corner,
QTreeView#pickerView QTableCornerButton::section {
    background: transparent;
    border: none;
}

QListWidget#pickerPlaces::item {
    border: none;
    padding-left: 8px;
    margin: 1px 0;
}
/* ---------------- 首次使用引导 ---------------- */
QWidget#guideCard {
    background-color: #1B1B1D;
    border: 1px solid #2F3746;
    border-radius: 14px;
}

QLabel#guideStep {
    color: #60A5FA;
    font-size: 13px;
}

QLabel#guideTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
}

QLabel#guideBody {
    color: #A8B3C6;
    font-size: 15px;
}

QPushButton#guideSkip {
    background: transparent;
    border: none;
    color: #6E747C;
    font-size: 13px;
    padding: 2px 2px;
}

QPushButton#guideSkip:hover {
    color: #C7D2E4;
}

QPushButton#guidePrev {
    background-color: #2E2E31;
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 80px;
}

QPushButton#guidePrev:hover {
    background-color: #353B48;
}

QPushButton#guidePrev:disabled {
    color: #6B7280;
    background-color: #232833;
}

QPushButton#guideNext {
    background-color: #4C8DFF;
    border-radius: 8px;
    padding: 8px 20px;
    min-width: 96px;
    font-weight: bold;
}

QPushButton#guideNext:hover {
    background-color: #2563EB;
}

/* ---------------- 软件更新窗口 ---------------- */
/* 背景/边框由 SquircleCard 自绘（连续曲率圆角） */
QFrame#updateShell {
    background: transparent;
    border: none;
}

QLabel#updateTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
}

QLabel#updateSubtitle {
    color: #6E747C;
    font-size: 13px;
}

QPushButton#updateClose {
    background: transparent;
    border: none;
    color: #8A93A5;
    font-size: 20px;
    border-radius: 8px;
}

QPushButton#updateClose:hover {
    background-color: #262628;
    color: #FFFFFF;
}

QFrame#updateBanner {
    background: transparent;
    border: none;
}

QLabel#updateBannerCaption {
    color: #6E747C;
    font-size: 13px;
}

QLabel#updateBannerValue {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
}

QLabel#updateBannerSub {
    color: #6E7888;
    font-size: 13px;
}

QFrame#updateStatusBar {
    background: transparent;
    border: none;
}

QLabel#updateStatusText {
    color: #C9D1E0;
    font-size: 15px;
}

QProgressBar#updateProgress {
    background-color: #262628;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
    height: 8px;
}

QProgressBar#updateProgress::chunk {
    background-color: #4C8DFF;
    border-radius: 4px;
}

QLabel#updateChip {
    background-color: #262628;
    border: 1px solid #2F3746;
    border-radius: 9px;
    padding: 2px 8px;
    color: #A8B3C6;
    font-size: 13px;
}

QFrame#updateCard {
    background: transparent;
    border: none;
}

QLabel#updateCardTitle {
    color: #E6EAF2;
    font-size: 15px;
    font-weight: bold;
}

QLabel#updateCardTitlePre {
    color: #FBBF24;
    font-size: 15px;
    font-weight: bold;
}

QLabel#updateVersion {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
}

QLabel#updateDate {
    color: #6E7888;
    font-size: 13px;
}

QLabel#updateState {
    color: #6E747C;
    font-size: 13px;
}

QPushButton#updateAction {
    background-color: #4C8DFF;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#updateAction:hover {
    background-color: #2563EB;
}

QPushButton#updateAction:disabled {
    background-color: #2A3340;
    color: #8892A3;
}

QScrollArea#updateNotes,
QWidget#updateNotesBody {
    background: transparent;
    border: none;
}

QLabel#updateNoteDot {
    color: #FBBF24;
    font-size: 13px;
}

/* 更新说明按「新增 / 调整 / 修复」分组的小标题与项目符号 */
QLabel#updateNoteKind {
    color: #9AA4B6;
    font-size: 13px;
    font-weight: bold;
    padding-top: 2px;
}

QLabel#updateNoteKind[kind="added"] {
    color: #34D399;
}

QLabel#updateNoteKind[kind="changed"] {
    color: #FBBF24;
}

QLabel#updateNoteKind[kind="fixed"] {
    color: #60A5FA;
}

QLabel#updateNoteDot2 {
    color: #6E747C;
    font-size: 13px;
}

QLabel#updateNoteDot2[kind="added"] {
    color: #34D399;
}

QLabel#updateNoteDot2[kind="changed"] {
    color: #FBBF24;
}

QLabel#updateNoteDot2[kind="fixed"] {
    color: #60A5FA;
}

QLabel#updateNote {
    color: #B7C0D0;
    font-size: 13px;
}

QPushButton#updateGhost {
    background: transparent;
    border: 1px solid #2E2E31;
    border-radius: 8px;
    padding: 6px 14px;
    color: #9C9C9F;
    font-size: 13px;
}

QPushButton#updateGhost:hover {
    color: #FFFFFF;
    border-color: #4C8DFF;
}

QPushButton#updateGhost:disabled {
    color: #5A6273;
}

QPushButton#updateSecondary {
    background-color: #2E2E31;
    border-radius: 8px;
    padding: 7px 20px;
    min-width: 80px;
}

QPushButton#updateSecondary:hover {
    background-color: #353B48;
}

/* 空状态提示 */
QLabel#emptyState {
    color: #6E7888;
    font-size: 15px;
    line-height: 22px;
}

/* 连续曲率圆角的卡片：背景和边框由 SquircleGroupBox 自绘，QSS 只负责标题和布局 */
QGroupBox[squircle="true"] {
    background: transparent;
    border: none;
    /* 卡片是自绘的，标题往下挪一点，别贴着卡片上边缘 */
    margin-top: 26px;
    padding-top: 18px;
}
/* 关于页的英文名 */
QLabel#aboutEnglish {
    color: #60A5FA;
    font-size: 13px;
    font-weight: bold;
    margin-top: -4px;
}
/* 页头右侧的次要信息（借用 Steamcommunity 302 的标题+计数排法） */
QLabel#pageMeta {
    color: #6E7888;
    font-size: 13px;
    padding-top: 6px;
}

QLabel#historyRowTitle {
    color: #E8EDF5;
    font-size: 15px;
}

QLabel#historyRowMeta {
    color: #6E747C;
    font-size: 13px;
}

QWidget#historyRow {
    background: transparent;
}

QListWidget#historyList::item {
    border-bottom: 1px solid #222834;
    padding: 2px 4px;
}

QListWidget#historyList::item:hover {
    background-color: #1B2130;
}
/* 列表行前的小图标（302 那种） */
QLabel#listIcon {
    background-color: #232A38;
    border-radius: 8px;
}

QListWidget#eventsList::item {
    padding: 8px 10px;
    border-bottom: 1px solid #222834;
}

QListWidget#eventsList::item:hover {
    background-color: #1B2130;
}
/* 关于页的可点击文本（Bug 反馈群） */
QLabel#aboutLink {
    color: #4C8DFF;
    font-size: 13px;
}
/* ============ 素材浏览 ============ */
QToolButton#albumViewBtn {
    background: #1B1B1D;
    border: 1px solid #262C39;
    border-radius: 8px;
    color: #9C9C9F;
    font-size: 15px;
}
QToolButton#albumViewBtn:hover { border-color: #4C8DFF; color: #FFFFFF; }
QToolButton#albumViewBtn:checked { background: #4C8DFF; border-color: #4C8DFF; color: #FFFFFF; }
QLineEdit#albumSearch {
    background: #1B1B1D; border: 1px solid #262C39; border-radius: 8px;
    padding: 6px 10px; color: #FFFFFF; selection-background-color: #4C8DFF;
}
QLineEdit#albumSearch:focus { border-color: #4C8DFF; }
QComboBox#albumSort {
    background: #1B1B1D; border: 1px solid #262C39; border-radius: 8px;
    padding: 6px 10px; color: #FFFFFF;
}
QComboBox#albumSort QAbstractItemView {
    background: #1B1B1D; color: #FFFFFF; selection-background-color: #4C8DFF;
    border: 1px solid #262C39; outline: none;
}
QListView#albumView { background: transparent; border: none; outline: none; }
/* 素材页工具栏：实心卡片，不用毛玻璃 */
QWidget#albumBar {
    background: #17181A;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
}