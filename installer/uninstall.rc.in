#pragma code_page(65001)
#include <windows.h>

IDI_ICON1 ICON "@APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "SwiQk-ovo"
            VALUE "FileDescription",  "拷备 卸载程序"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "CjibackupUninstall"
            VALUE "LegalCopyright",   "© 2026 SwiQk-ovo"
            VALUE "OriginalFilename", "CjibackupUninstall.exe"
            VALUE "ProductName",      "拷备"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
